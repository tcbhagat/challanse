# ChallanSe Enrichment Service — Environment Configuration
# Copy this file to .env and fill in your values.
#
# Required settings for local-pilot mode:
#   ENVIRONMENT=local-pilot
#   DATABASE_URL=postgresql://...
#   EDGE_TO_ENRICHMENT_HMAC_KEY=<generate-a-random-key>
#   EDGE_TO_ENRICHMENT_HMAC_KEY_ID=<key-id>
#   LOCAL_DATA_ROOT=/srv/challanse
#   LOCAL_AUTH_ENCRYPTION_KEY=<generate-a-random-key>
#
# For more detail see docs/local-pilot.md

# === Runtime ===
ENVIRONMENT=development
SYNTHETIC_MODE=false

# === PostgreSQL ===
DATABASE_URL=
SYSTEM_DATABASE_URL=
DATABASE_ADMIN_URL=

# === AWS ===
AWS_REGION=ap-south-1
RECEIPT_QUEUE_URL=
RECEIPT_BUCKET=
CREDIT_QUEUE_URL=
KMS_KEY_ARN=

# === HMAC signing (edge ↔ enrichment) ===
EDGE_TO_ENRICHMENT_HMAC_KEY_ID=
EDGE_TO_ENRICHMENT_HMAC_KEY=
EDGE_TO_ENRICHMENT_NEXT_HMAC_KEY_ID=
EDGE_TO_ENRICHMENT_NEXT_HMAC_KEY=
ENRICHMENT_TO_EDGE_HMAC_KEY_ID=
ENRICHMENT_TO_EDGE_HMAC_KEY=
ENRICHMENT_TO_EDGE_NEXT_HMAC_KEY_ID=
ENRICHMENT_TO_EDGE_NEXT_HMAC_KEY=

# === Cloudflare Access ===
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# === Device auth ===
DEVICE_TOKEN_PEPPER=
TENANT_CONTEXT_HMAC_KEY=

# === OCR ===
# Options: disabled, mock, textract, local
OCR_PROVIDER=disabled

# === GST ===
# Options: disabled, mock, http
GST_PROVIDER=disabled
GST_API_URL=https://mock-gst-portal.in/api/irn
GST_TIMEOUT_SECONDS=3.0

# === Notifications ===
# Options: disabled, mock, whatsapp
NOTIFICATION_PROVIDER=disabled
# Options: disabled, mock, sqs
CREDIT_PROVIDER=disabled
# Options: disabled, mock, webhook
SLACK_PROVIDER=disabled

# === Event queue ===
# Options: disabled, memory, sqs, postgres
EVENT_QUEUE_PROVIDER=disabled

# === Object store ===
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_SSE_MODE=kms

# === Local LLM (local-pilot) ===
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=90.0

# === Tesseract ===
TESSERACT_LANGUAGES=eng+hin

# === Local data ===
LOCAL_DATA_ROOT=/srv/challanse
LOCAL_STORAGE_LIMIT_BYTES=20000000000

# === Local auth ===
LOCAL_AUTH_ENCRYPTION_KEY=
LOCAL_SESSION_TTL_MINUTES=480

# === Local acceptance ===
LOCAL_ACCEPTANCE_BASE_URL=http://edge:8787
LOCAL_BUILD_COMMIT_SHA=unknown
LOCAL_TLS_CERTIFICATE_PATH=

# === Telemetry ===
OTEL_SERVICE_NAME=challanse-enrichment
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Image limits ===
IMAGE_BYTE_LIMIT=5000000

# === URLs ===
REVIEW_DASHBOARD_URL=https://review.challanse.constrovet.com
PUBLIC_API_URL=https://api.challanse.constrovet.com

# === Play Integrity ===
# Options: disabled, google
PLAY_INTEGRITY_PROVIDER=disabled
PLAY_INTEGRITY_CREDENTIALS_JSON=
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=0
