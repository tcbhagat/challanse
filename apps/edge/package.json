{
  "name": "@challanse/edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/render-edge-config.mjs --ci && wrangler deploy --dry-run --outdir dist --config config/edge.ci.toml",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "node ../../scripts/render-edge-config.mjs --production && wrangler deploy --config config/edge.production.toml"
  },
  "dependencies": {
    "@challanse/contracts": "1.0.0",
    "jose": "6.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
